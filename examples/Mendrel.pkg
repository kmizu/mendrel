package {
    name: "shop_checkout",
    version: "0.1.0",
    edition: "2026",
    license: "Apache-2.0",
    source: "src",
}

targets {
    library "checkout_core" {
        module: "shop.checkout",
    }

    service "checkout_service" {
        module: "shop.main",
    }
}

dependencies {
    "std_http": {
        version: "2.1.3",
        checksum: "sha256:31dc0f4cf6b4c77d6033e584f93adf58912d2a9ba927864dfbc8c1aa5cb6579f",
    },
    "std_postgres": {
        version: "1.7.0",
        checksum: "sha256:11b1a3bbad758c82e6165b34ab36697bf0fb8e8057195266e8c81decb9efd58f",
    },
}

capabilities {
    production: [
        "network.client:payments.example",
        "database.postgres:orders",
        "secret.read:payments/*",
        "telemetry.emit",
        "time.monotonic",
    ],
    test: [
        "time.virtual",
        "random.seeded",
        "telemetry.record",
    ],
}

unsafe {
    allowed_packages: [],
}

build {
    reproducible: true,
    warnings: "deny",
    holes: "deny",
    generated_sources: "check",
}
